{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://unlost-backend-mu.vercel.app/api/:path*"
    },
    {
      "source": "/static/uploads/:path*",
      "destination": "https://unlost-backend-mu.vercel.app/static/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
