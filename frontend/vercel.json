{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://unlost-backend-mu.vercel.app/api/$1"
    },
    {
      "src": "/static/uploads/(.*)",
      "dest": "https://unlost-backend-mu.vercel.app/static/uploads/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
